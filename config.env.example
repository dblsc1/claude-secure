# claude-secure 配置。复制到 ~/.config/claude-secure/config.env 后按自己的环境改。
# 所有脚本启动时 source 它；缺失时用下面注释里写的默认值。
#
# 这个文件本身不该进 git（真实的仓名、目录名属于你的私有信息）。

# ── 工作区 ────────────────────────────────────────────────────────────
# 沙箱里唯一挂进去的工作区根目录。默认 $HOME/workspace。
CS_WORKSPACE="$HOME/workspace"

# pub 身份（只负责把指名提交 cherry-pick 到公开仓）在工作区里能看到的**唯一**
# 顶层目录。保留清单，不是排除清单：漏一条只是少个功能，排除清单漏一条就是泄露。
CS_PUB_DIR="public-work"

# 上面那个目录里，连 pub 也不许看的子目录（启动时用 tmpfs 盖空）。空格分隔。
CS_PUB_HIDDEN="private-notes scratch"

# ── GitHub ────────────────────────────────────────────────────────────
# git 凭据按 URL owner 路由：个人仓用 personal 令牌，组织仓用 org 令牌。
CS_GH_USER="your-github-login"
CS_GH_ORG="your-github-org"

# 推送闸门认的公开仓白名单（owner/repo，空格分隔）。不在清单里的仓一律拒推。
CS_PUBLIC_REPOS="your-github-login/public-repo your-github-org/another-public-repo"

# 沙箱里 git 提交用的身份。
CS_GIT_NAME="your-github-login"
CS_GIT_EMAIL="you@example.com"

# ── 推送闸门 ──────────────────────────────────────────────────────────
# 密钥扫描脚本（接收 <base-sha> <head-sha>，非零退出即拒推）。留空则闸门拒绝放行。
CS_SCAN_SCRIPT="$HOME/workspace/security/scan-before-push.sh"

# 商业术语清单：一行一条，命中即拒推（提交信息和 diff 都扫）。
# 内容本身敏感，不要进 git。文件不存在时闸门直接拒绝放行。
CS_BUSINESS_TERMS="$HOME/.local/share/claude-secure/secrets/business-terms.txt"

# ── 网络 ──────────────────────────────────────────────────────────────
# 沙箱内看到的代理端口（由宿主侧 systemd socket 转发到真正的代理）。
CS_PROXY_PORT=7894
CS_LAN_PROXY_PORT=7895
CS_TZ="Asia/Taipei"

# 推送闸门允许改动的路径前缀（空格分隔）。同样是保留清单。
CS_ALLOW_PATHS="docs README.md LICENSE"
