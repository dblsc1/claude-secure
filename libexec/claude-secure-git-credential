#!/usr/bin/env bash
# git credential helper for claude-secure identity sandboxes.
#
# Does not know which identity (pri/pub) it is running as, and does not need
# to: the launcher decides that by choosing which 2 real token files get
# ro-bind mounted at the fixed in-sandbox paths below. This script only
# routes by URL owner ($CS_GH_USER = personal, $CS_GH_ORG = org, both passed in
# by the launcher via --setenv) to whichever of
# those 2 files is present. The other identity's tokens are never mounted
# into this sandbox at all, so there is nothing here that could leak them.
set -euo pipefail

[[ "${1:-}" == get ]] || exit 0

path=""
while IFS='=' read -r key val; do
  [[ "$key" == path ]] && path="$val"
done

owner="${path%%/*}"
case "$owner" in
  "${CS_GH_USER:-}") tokfile=/opt/claude/credentials/personal.token ;;
  "${CS_GH_ORG:-}")  tokfile=/opt/claude/credentials/org.token ;;
  *)                 exit 0 ;;
esac
[[ -n "$owner" ]] || exit 0

[[ -r "$tokfile" ]] || exit 0
printf 'username=x-access-token\n'
printf 'password=%s\n' "$(cat "$tokfile")"
